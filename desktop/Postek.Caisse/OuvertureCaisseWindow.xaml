<Window x:Class="Postec.Caisse.OuvertureCaisseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POSTEC - Ouverture de caisse"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource CouleurFond}"
        FontFamily="{DynamicResource FamillePolice}">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ouverture de caisse" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource CouleurPrimaire}"/>
            <TextBlock Text="Préparez le tiroir avant de commencer les ventes."
                       Margin="0,6,0,24" Foreground="{DynamicResource CouleurTexteSecondaire}"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Caissier connecté" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Caissier}" FontSize="18" Margin="0,3,0,22"/>
            <TextBlock Text="Fonds de caisse initial (TND)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding FondsInitialTexte, UpdateSourceTrigger=PropertyChanged}"
                     Height="52" FontSize="26" Padding="10" Margin="0,6,0,12"
                     HorizontalContentAlignment="Right"/>
            <TextBlock Text="{Binding Message}" Foreground="#DC2626" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Row="2" Content="Ouvrir la caisse" Height="54" FontSize="17"
                FontWeight="Bold" Background="#16A34A" Foreground="White"
                BorderThickness="0" Click="SurOuvrir"/>
    </Grid>
</Window>
