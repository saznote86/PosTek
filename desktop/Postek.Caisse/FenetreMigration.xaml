<Window x:Class="Postec.Caisse.FenetreMigration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POSTEC - Migration de données"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CouleurFond}"
        FontFamily="{DynamicResource FamillePolice}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Assistant de migration" FontSize="26" FontWeight="Bold"
                   Foreground="{DynamicResource CouleurTexte}"/>
        <TextBlock Grid.Row="1" Text="Importez les exports de données dans la base POSTEC avec contrôle et rapport."
                   Margin="0,6,0,18" Foreground="{DynamicResource CouleurTexteSecondaire}"/>
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Text="Dossier source" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="ChampExports" Grid.Column="1" Height="32" Padding="8"/>
            <Button Grid.Column="2" Content="Choisir..." Margin="8,0,0,0" Padding="14,0" Click="SurChoisirExports"/>
            <TextBlock Grid.Row="1" Text="Base SQLite" VerticalAlignment="Center" Margin="0,10,12,0"/>
            <TextBox x:Name="ChampBase" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,10,0,0" Padding="8"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Choisir..." Margin="8,10,0,0" Padding="14,0" Click="SurChoisirBase"/>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource CouleurSurface}" CornerRadius="10" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Progression" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListeEtapes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Etape}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Statut}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Details}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource CouleurTexteSecondaire}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <TextBlock x:Name="TexteEtat" VerticalAlignment="Center" Foreground="{DynamicResource CouleurTexteSecondaire}"/>
            <Button x:Name="BoutonLancer" HorizontalAlignment="Right" Content="Lancer la migration"
                    Padding="18,10" Background="{DynamicResource CouleurPrimaire}" Foreground="White"
                    BorderThickness="0" Click="SurLancer"/>
        </Grid>
    </Grid>
</Window>
