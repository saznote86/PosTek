<Window x:Class="Postec.Caisse.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Postec.Caisse" Title="POSTEC - Connexion" Width="500" Height="900" MinHeight="900" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" Background="#0F172A" Foreground="White" FontFamily="Segoe UI" Loaded="SurChargement" AutomationProperties.Name="Connexion POSTEC">
    <Window.Resources>
        <Style x:Key="BoutonClavier" TargetType="Button">
            <Setter Property="Margin" Value="5"/><Setter Property="Height" Value="68"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#3B82F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Fond" Background="{TemplateBinding Background}" CornerRadius="11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fond" Property="Background" Value="#9CA3AF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Fond" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="BoutonAction" TargetType="Button" BasedOn="{StaticResource BoutonClavier}"><Setter Property="Height" Value="54"/><Setter Property="FontSize" Value="17"/></Style>
        <Style x:Key="ElementUtilisateur" TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#0F172A"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Padding" Value="10,8"/></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Border CornerRadius="16" Padding="24" BorderThickness="2"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1E293B"/><GradientStop Color="#0F172A" Offset="1"/></LinearGradientBrush></Border.Background><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B82F6"/><GradientStop Color="#1E3A8A" Offset="1"/></LinearGradientBrush></Border.BorderBrush><Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.55" Color="#000000"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="POSTEC" FontSize="46" FontWeight="Black" HorizontalAlignment="Center" Foreground="#60A5FA"/>
                <TextBlock Grid.Row="1" Text="Connexion caisse" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,22"/>
                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                    <TextBlock Text="Identifiant" FontSize="14" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbUtilisateur" Grid.Row="1" Height="48" FontSize="16" Padding="10,0" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#3B82F6" BorderThickness="2" ItemsSource="{Binding Utilisateurs}" SelectedItem="{Binding UtilisateurSelectionne, Mode=TwoWay}" ItemContainerStyle="{StaticResource ElementUtilisateur}" IsEditable="False" AutomationProperties.Name="Identifiant"/>
                    <TextBlock Grid.Row="2" Text="Mot de passe" FontSize="14" Foreground="#CBD5E1" Margin="0,18,0,6"/>
                    <PasswordBox x:Name="PwdMotDePasse" Grid.Row="3" Height="48" FontSize="16" Padding="10,0" Background="#1E293B" Foreground="White" BorderBrush="#3B82F6" BorderThickness="2" local:PasswordHelper.Password="{Binding MotDePasse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mot de passe" KeyDown="SurMotDePasseKeyDown"/>
                </Grid>
                <UniformGrid Grid.Row="3" Columns="3" Rows="4" Margin="0,18,0,0">
                    <Button Content="7" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="7"/><Button Content="8" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="8"/><Button Content="9" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="9"/>
                    <Button Content="4" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="4"/><Button Content="5" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="5"/><Button Content="6" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="6"/>
                    <Button Content="1" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="1"/><Button Content="2" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="2"/><Button Content="3" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="3"/>
                    <Button Content="0" Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter="0"/><Button Content="," Style="{StaticResource BoutonClavier}" Command="{Binding ChiffreCommand}" CommandParameter=","/><Button Content="C" Background="#EF4444" Style="{StaticResource BoutonClavier}" Command="{Binding EffacerCommand}" ToolTip="Effacer le mot de passe"/>
                </UniformGrid>
                <TextBlock Grid.Row="4" Text="{Binding MessageErreur}" FontSize="12" Foreground="#FCA5A5" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <Grid Grid.Row="5" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Annuler" Background="#EF4444" Style="{StaticResource BoutonAction}" Command="{Binding AnnulerCommand}" ToolTip="Fermer la connexion"/><Button Grid.Column="1" Content="Valider" Background="#10B981" Style="{StaticResource BoutonAction}" Command="{Binding ValiderCommand}" Margin="12,5,0,5" ToolTip="Valider la connexion"/></Grid>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><TextBlock Text="🔒" Foreground="#64748B"/><TextBlock Text="Accès sécurisé - POSTEC" FontSize="11" Foreground="#64748B" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>