<UserControl x:Class="Postec.Caisse.Views.ComptabiliteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PostecFondBrush}"><DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Comptabilité et Statistiques" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PostecPrimaireBrush}"/><TextBlock Text="Balance, grand livre et bilan" Style="{StaticResource PostecLabel}"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Actualiser" Command="{Binding ModifierCommand}" Style="{StaticResource PostecButtonSecondary}"/><Button Content="Retour" Command="{Binding RetourCommand}" Style="{StaticResource PostecButtonLarge}"/></StackPanel><DataGrid ItemsSource="{Binding Lignes}" AutoGenerateColumns="False" Margin="0,20,0,12" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="État" Binding="{Binding Code}"/><DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}"/><DataGridTextColumn Header="Montant" Binding="{Binding Valeur}"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding Message}" Style="{StaticResource PostecLabel}"/></DockPanel></UserControl>
