<UserControl x:Class="Postec.Caisse.Views.FamillesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PostecFondBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Familles de produits" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PostecPrimaireBrush}"/>
            <TextBlock Text="Organisez vos produits par catégories" Style="{StaticResource PostecLabel}" Margin="0,4,0,16"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Libellé" Style="{StaticResource PostecLabel}"/>
                <TextBox x:Name="ChampLibelle" Style="{StaticResource PostecInput}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0">
                <TextBlock Text="Code (optionnel)" Style="{StaticResource PostecLabel}"/>
                <TextBox x:Name="ChampCode" Style="{StaticResource PostecInput}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Text="Ordre d'affichage" Style="{StaticResource PostecLabel}"/>
                <TextBox x:Name="ChampOrdre" Text="0" Style="{StaticResource PostecInput}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,58,0,0">
            <Button Content="Nouvelle famille" Click="SurNouvelleFamille" Style="{StaticResource PostecButtonSecondary}"/>
            <Button Content="Enregistrer" Click="SurEnregistrer" Style="{StaticResource PostecButtonSuccess}"/>
            <Button Content="Supprimer" Click="SurSupprimer" Style="{StaticResource PostecButtonDanger}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="ListeFamilles" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="SurSelectionFamille">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*"/>
                <DataGridTextColumn Header="Ordre" Binding="{Binding Ordre}" Width="80"/>
                <DataGridTextColumn Header="Nombre de produits" Binding="{Binding NbProduits}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Fermer" Click="SurFermer" Style="{StaticResource PostecButtonLarge}" HorizontalAlignment="Right" Width="120" Margin="0,16,0,0"/>
    </Grid>
</UserControl>