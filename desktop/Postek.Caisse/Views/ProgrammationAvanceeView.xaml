<UserControl x:Class="Postec.Caisse.Views.ProgrammationAvanceeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PostecFondBrush}"><DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Programmation Avancée" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PostecPrimaireBrush}"/><TextBlock Text="Paramètres avancés du poste" Style="{StaticResource PostecLabel}"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Enregistrer" Command="{Binding ModifierCommand}" Style="{StaticResource PostecButtonSuccess}"/><Button Content="Retour" Command="{Binding RetourCommand}" Style="{StaticResource PostecButtonLarge}"/></StackPanel><DataGrid ItemsSource="{Binding Lignes}" AutoGenerateColumns="False" Margin="0,20,0,12" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Paramètre" Binding="{Binding Code}"/><DataGridTextColumn Header="Valeur" Binding="{Binding Libelle}"/><DataGridTextColumn Header="État" Binding="{Binding Valeur}"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding Message}" Style="{StaticResource PostecLabel}"/></DockPanel></UserControl>
