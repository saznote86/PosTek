<UserControl x:Class="Postec.Caisse.Views.ClientsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PostecFondBrush}">
    <DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Clients" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PostecPrimaireBrush}"/><TextBlock Text="Fichier clients" Style="{StaticResource PostecLabel}"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Nouveau" Command="{Binding NouveauCommand}" Style="{StaticResource PostecButtonSuccess}"/><Button Content="Modifier" Command="{Binding ModifierCommand}" Style="{StaticResource PostecButtonSecondary}"/><Button Content="Supprimer" Command="{Binding SupprimerCommand}" Style="{StaticResource PostecButtonDanger}"/><Button Content="Retour" Command="{Binding RetourCommand}" Style="{StaticResource PostecButtonLarge}"/></StackPanel><DataGrid ItemsSource="{Binding Clients}" SelectedItem="{Binding ClientSelectionne,Mode=TwoWay}" AutoGenerateColumns="False" Margin="0,20,0,12" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}"/><DataGridTextColumn Header="Nom" Binding="{Binding Nom}"/><DataGridTextColumn Header="Raison sociale" Binding="{Binding RaisonSociale}"/><DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}"/><DataGridTextColumn Header="Matricule fiscal" Binding="{Binding MatriculeFiscal}"/><DataGridTextColumn Header="Solde" Binding="{Binding Solde,StringFormat={}{0:N3}}"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding Message}" Style="{StaticResource PostecLabel}"/></DockPanel>
</UserControl>
