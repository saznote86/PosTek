<UserControl x:Class="Postec.Caisse.Views.VentilationsTarifsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PostecFondBrush}"><DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Ventilations et Tarifs" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PostecPrimaireBrush}"/><TextBlock Text="Taux TVA et grilles tarifaires" Style="{StaticResource PostecLabel}"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Nouveau" Command="{Binding NouveauCommand}" Style="{StaticResource PostecButtonSuccess}"/><Button Content="Modifier" Command="{Binding ModifierCommand}" Style="{StaticResource PostecButtonSecondary}"/><Button Content="Retour" Command="{Binding RetourCommand}" Style="{StaticResource PostecButtonLarge}"/></StackPanel><DataGrid ItemsSource="{Binding Lignes}" AutoGenerateColumns="False" Margin="0,20,0,12" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}"/><DataGridTextColumn Header="Taux" Binding="{Binding Libelle}"/><DataGridTextColumn Header="Tarif" Binding="{Binding Valeur}"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding Message}" Style="{StaticResource PostecLabel}"/></DockPanel></UserControl>
