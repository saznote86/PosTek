<UserControl x:Class="Postec.Caisse.Views.HistoriqueTicketsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PostecFondBrush}"><DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Historique des Tickets" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PostecPrimaireBrush}"/><TextBlock Text="Consultation des ventes enregistrées" Style="{StaticResource PostecLabel}"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Filtrer" Command="{Binding ModifierCommand}" Style="{StaticResource PostecButtonSecondary}"/><Button Content="Retour" Command="{Binding RetourCommand}" Style="{StaticResource PostecButtonLarge}"/></StackPanel><DataGrid ItemsSource="{Binding Lignes}" AutoGenerateColumns="False" Margin="0,20,0,12" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Ticket" Binding="{Binding Code}"/><DataGridTextColumn Header="Date" Binding="{Binding Libelle}"/><DataGridTextColumn Header="Total" Binding="{Binding Valeur}"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding Message}" Style="{StaticResource PostecLabel}"/></DockPanel></UserControl>
