<UserControl x:Class="Postec.Caisse.Views.Controls.ProductCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="168" Width="114" Margin="2">
    <Button Style="{StaticResource ToucheArticle}"
             Width="110"
             Height="160"
            MinHeight="160"
            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Command}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Article}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0"
                   Source="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Article.CheminImage, Converter={StaticResource CheminImageConverter}}"
                    Height="64"
                   Width="64"
                   Stretch="Uniform"
                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Article.CheminImage, Converter={StaticResource NullToVisibilityConverter}}"/>
            <TextBlock Grid.Row="0"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Article.Emoji}"
                       FontSize="46"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Article.CheminImage, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Article.Designation}"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                           Foreground="#1E293B" FontWeight="SemiBold" MaxHeight="32"/>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Article.PrixTtc, StringFormat={}{0:0.000} TND}"
                           TextAlignment="Center" FontSize="10"
                           Foreground="#2563EB"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
