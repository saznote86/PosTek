<UserControl x:Class="Postec.Caisse.Views.Controls.NumericKeypad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UniformGrid Columns="3" Rows="4">
        <Button Content="7" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="7"/>
        <Button Content="8" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="8"/>
        <Button Content="9" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="9"/>
        <Button Content="4" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="4"/>
        <Button Content="5" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="5"/>
        <Button Content="6" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="6"/>
        <Button Content="1" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="1"/>
        <Button Content="2" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="2"/>
        <Button Content="3" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="3"/>
        <Button Content="0" Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="0"/>
        <Button Content="," Style="{StaticResource PostecKeypadButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter=","/>
        <Button Content="C" Style="{StaticResource PostecButtonDanger}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NumberPressedCommand}" CommandParameter="C"/>
    </UniformGrid>
</UserControl>
