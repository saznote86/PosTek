<UserControl x:Class="Postec.Caisse.Views.Controls.CartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PostecCarte}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="TICKET EN COURS" Style="{StaticResource PostecLabel}"/>
                <Border HorizontalAlignment="Right" Style="{StaticResource PostecBadge}">
                    <TextBlock Text="{Binding NbArticles}" Foreground="White" FontWeight="Bold"/>
                </Border>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lignes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource PostecBordureBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="78"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Article.Designation}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Article.PrixTtc, StringFormat=PU {0:0.000} TND}" Foreground="{StaticResource PostecTexteSecondaireBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantite, StringFormat={}{0:0.###}x}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalLigne, StringFormat={}{0:0.000}}" Style="{StaticResource PostecMontant}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
