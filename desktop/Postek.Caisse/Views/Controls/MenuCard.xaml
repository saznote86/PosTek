<UserControl x:Class="Postec.Caisse.Views.Controls.MenuCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="180" MinHeight="92">
 <Button Style="{StaticResource PostecButtonLarge}" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Command}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=CommandParameter}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Icone}" FontSize="28" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Titre}"/><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Raccourci}" FontSize="11" Foreground="{StaticResource PostecTexteSecondaireBrush}"/></StackPanel></StackPanel></Button>
</UserControl>
