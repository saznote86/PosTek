<UserControl x:Class="Postec.Caisse.Views.Controls.FinancialSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PostecCarte}">
        <StackPanel>
            <TextBlock Text="RÉSUMÉ FINANCIER" Style="{StaticResource PostecLabel}" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding SousTotalHt, StringFormat=SOUS-TOTAL HT : {0:0.000} TND}" Foreground="{StaticResource PostecTexteSecondaireBrush}" FontSize="14" Margin="0,3"/>
            <TextBlock Text="{Binding TotalTva, StringFormat=TVA : {0:0.000} TND}" Foreground="{StaticResource PostecTexteSecondaireBrush}" FontSize="14" Margin="0,3"/>
            <TextBlock Text="Timbre fiscal : 1,000 TND" Foreground="{StaticResource PostecTexteSecondaireBrush}" FontSize="14" Margin="0,3"/>
            <Separator Margin="0,10"/>
            <TextBlock Text="{Binding TotalTtc, StringFormat=TOTAL TTC : {0:0.000} TND}" Style="{StaticResource PostecMontant}"/>
        </StackPanel>
    </Border>
</UserControl>
