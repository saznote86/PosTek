<UserControl x:Class="Postec.Caisse.Views.ClotureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CouleurFond}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="Clôture de caisse" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource CouleurPrimaire}"/>
            <TextBlock DockPanel.Dock="Right" Text="RAPPORT Z" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource CouleurTexteSecondaire}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource CouleurSurface}" Padding="18" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Récapitulatif des ventes" FontSize="20" FontWeight="Bold"/>
                    <DataGrid ItemsSource="{Binding RecapZ.ReglementsParMode}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,14,0,0">
                        <DataGrid.Columns><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="*"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:0.000} DT}" Width="160"/></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <TextBlock Text="Nombre de tickets"/><TextBlock Text="{Binding RecapZ.NbTickets}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Total ventes TTC" Margin="0,8,0,0"/><TextBlock Text="{Binding RecapZ.TotalTtc, StringFormat={}{0:0.000} DT}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CouleurPrimaire}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource CouleurSurface}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="Fonds initial" Style="{StaticResource PostecLabel}"/><TextBlock Text="{Binding FondsInitial, StringFormat={}{0} DT}" FontSize="20" Margin="0,4,0,14"/>
                    <TextBlock Text="Fonds de caisse final" Style="{StaticResource PostecLabel}"/>
                    <TextBox Text="{Binding FondsFinalTexte, UpdateSourceTrigger=PropertyChanged}" FontSize="24" Height="52" Padding="10" Margin="0,6,0,10"/>
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <Button Content="1" Command="{Binding ToucheFondsCommand}" CommandParameter="1" Height="42" Margin="2"/><Button Content="2" Command="{Binding ToucheFondsCommand}" CommandParameter="2" Height="42" Margin="2"/><Button Content="3" Command="{Binding ToucheFondsCommand}" CommandParameter="3" Height="42" Margin="2"/>
                        <Button Content="4" Command="{Binding ToucheFondsCommand}" CommandParameter="4" Height="42" Margin="2"/><Button Content="5" Command="{Binding ToucheFondsCommand}" CommandParameter="5" Height="42" Margin="2"/><Button Content="6" Command="{Binding ToucheFondsCommand}" CommandParameter="6" Height="42" Margin="2"/>
                        <Button Content="7" Command="{Binding ToucheFondsCommand}" CommandParameter="7" Height="42" Margin="2"/><Button Content="8" Command="{Binding ToucheFondsCommand}" CommandParameter="8" Height="42" Margin="2"/><Button Content="9" Command="{Binding ToucheFondsCommand}" CommandParameter="9" Height="42" Margin="2"/>
                        <Button Content="Effacer" Command="{Binding ToucheFondsCommand}" CommandParameter="Effacer" Height="42" Margin="2"/><Button Content="0" Command="{Binding ToucheFondsCommand}" CommandParameter="0" Height="42" Margin="2"/><Button Content="Retour" Command="{Binding ToucheFondsCommand}" CommandParameter="Retour" Height="42" Margin="2"/>
                        <Button Content="," Command="{Binding ToucheFondsCommand}" CommandParameter="," Height="42" Margin="2"/>
                    </UniformGrid>
                    <TextBlock Text="Écart de caisse" Style="{StaticResource PostecLabel}"/>
                    <TextBlock Text="{Binding EcartLibelle}" Foreground="{Binding EcartCouleur}" FontSize="21" FontWeight="Bold" Margin="0,6,0,18"/>
                    <TextBlock Text="Signature caissier" Style="{StaticResource PostecLabel}"/>
                    <TextBox Text="{Binding SignatureCaissier, UpdateSourceTrigger=PropertyChanged}" Height="54" FontSize="20" Padding="10" Margin="0,6,0,8"/>
                    <Button Content="Effacer la signature" Command="{Binding EffacerSignatureCommand}" Height="44" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource CouleurAlerte}" TextWrapping="Wrap" Margin="0,4"/>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Annuler" Command="{Binding AnnulerClotureCommand}" Height="56" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="Valider la clôture" Command="{Binding ValiderClotureCommand}" Height="56" Margin="5,0,0,0" Background="{DynamicResource CouleurSucces}" Foreground="White" FontWeight="Bold"/>
                    </Grid>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="Confirmez les montants avant validation. La clôture est irréversible." Foreground="{DynamicResource CouleurTexteSecondaire}" Margin="0,14,0,0"/>
    </Grid>
</UserControl>
