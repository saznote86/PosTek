<Window x:Class="Postec.Caisse.Views.ReindexerModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réindexer" Width="620" Height="430" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CouleurFond}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="RÉINDEXER" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource CouleurPrimaire}"/>
        <Grid Grid.Row="1" Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Répertoire" Margin="0,0,0,4"/><TextBox Text="{Binding Chemin, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8"/></StackPanel>
            <Button Grid.Column="1" Content="Parcourir" Click="SurParcourir" Margin="8,0,0,0"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource CouleurTexteSecondaire}"/>
            <ProgressBar IsIndeterminate="True" Height="8" Margin="0,8,0,0" Visibility="{Binding EstEnCours, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="Les index de la base seront reconstruits sans modifier les données." TextWrapping="Wrap" Foreground="{DynamicResource CouleurTexteSecondaire}"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abandon" Command="{Binding FermerCommand}" Style="{StaticResource PostecButtonDanger}"/>
            <Button Content="Réindexer" Command="{Binding ReindexerCommand}" Style="{StaticResource PostecButtonSuccess}"/>
        </StackPanel>
    </Grid>
</Window>
