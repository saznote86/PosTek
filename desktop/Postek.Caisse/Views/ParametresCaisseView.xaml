<UserControl x:Class="Postec.Caisse.Views.ParametresCaisseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PostecFondBrush}">
 <DockPanel Margin="24"><Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Parametres - Caisse n°1" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PostecPrimaireBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="Recherche" Width="220" Style="{StaticResource PostecInput}"/><Button Content="Suivant" Style="{StaticResource PostecButtonSecondary}" Click="SurSuivant"/></StackPanel></Grid><DataGrid ItemsSource="{Binding Parametres}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="46"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="Valeur" Binding="{Binding Valeur}" Width="180"/><DataGridTextColumn Header="Complém." Binding="{Binding Complement}" Width="180"/><DataGridTextColumn Header="Obs" Binding="{Binding Observation}" Width="*" IsReadOnly="True"/></DataGrid.Columns></DataGrid></DockPanel>
</UserControl>
