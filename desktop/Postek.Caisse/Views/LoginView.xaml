<UserControl x:Class="Postec.Caisse.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PostecFondBrush}">
    <Border Width="400" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
            Style="{StaticResource PostecCarte}">
        <StackPanel>
            <TextBlock Text="POSTEC" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{StaticResource PostecPrimaireBrush}"/>
            <TextBlock Text="Authentification" FontSize="18" HorizontalAlignment="Center"
                       Foreground="{StaticResource PostecTexteSecondaireBrush}" Margin="0,4,0,18"/>
            <TextBlock Text="Identifiant" Style="{StaticResource PostecLabel}"/>
            <Grid Margin="0,6,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource PostecPrimaireBrush}"/>
                <ComboBox x:Name="ChampIdentifiant" Grid.Column="1" Height="48" FontSize="18"
                          Padding="12,0" IsEditable="True" IsTextSearchEnabled="True"
                          DisplayMemberPath="NomUtilisateur"
                          ItemsSource="{Binding UtilisateursRecents}"
                          SelectedItem="{Binding UtilisateurSelectionne}"
                          Text="{Binding NomUtilisateurSaisi, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="SurUtilisateurSelectionne"/>
            </Grid>
            <TextBlock Text="Mot de passe" Style="{StaticResource PostecLabel}"/>
            <PasswordBox x:Name="ChampMotDePasse" Height="48" FontSize="22" Padding="12" Margin="0,6,0,10"/>
            <views:NumericKeypad x:Name="Clavier" xmlns:views="clr-namespace:Postec.Caisse.Views.Controls"
                                 NumberPressedCommand="{Binding NumberPressedCommand}" HorizontalAlignment="Center"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Annuler" Style="{StaticResource PostecButtonDanger}" Click="SurAnnuler"/>
                <Button Grid.Column="1" Content="Valider  ✓" Style="{StaticResource PostecButtonSuccess}" Click="SurValider"/>
            </Grid>
            <TextBlock x:Name="TexteErreur" Foreground="{StaticResource PostecDangerBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
