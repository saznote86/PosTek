<UserControl x:Class="Postec.Caisse.Views.AccueilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="AccueilButton" TargetType="Button">
            <Setter Property="Height" Value="60"/><Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="18,8"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.86"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Border Width="900" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E61E3A8B"/><GradientStop Color="#E60F172A" Offset="1"/></LinearGradientBrush></Border.Background>
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="15" Color="#000000" Opacity="0.7"/></Border.Effect>
            <Grid Margin="24">
                <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel><TextBlock Text="V 1.0.0 PRO" FontSize="14" FontWeight="Bold" Foreground="White"/><TextBlock Text="Administrateur" Foreground="#94A3B8" FontSize="12"/></StackPanel>
                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="Poste N°2" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="{Binding DateTexte}" Foreground="#CBD5E1" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="{Binding SaintsTexte}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                    <Border HorizontalAlignment="Right" Background="#F59E0B" CornerRadius="8" Padding="12,8"><StackPanel><TextBlock Text="ATTENTION :" FontSize="11" FontWeight="Bold" Foreground="White"/><TextBlock Text="Licence Limitée" FontSize="10" Foreground="#FEF3C7"/><TextBlock Text="au mode consultation" FontSize="10" Foreground="#FEF3C7"/></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="1" Margin="16,20,16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="POSTEC" FontSize="72" FontWeight="Black" Foreground="White" Effect="{DynamicResource AccueilLogoShadow}"/>
                        <TextBlock Text="Solution de Caisse Professionnelle" FontSize="20" Foreground="#CBD5E1" Margin="0,8,0,0"/>
                        <Border Height="180" Margin="0,35,0,0" CornerRadius="12" Background="#331E293B" BorderBrush="#6694A3B8" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▣" FontSize="100" Foreground="#CBD5E1" HorizontalAlignment="Center"/><TextBlock Text="POSTEC POS" Foreground="#94A3B8" FontSize="14"/></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Caisse        F1" Background="#10B981" Style="{StaticResource AccueilButton}" Command="{Binding CaisseCommand}" ToolTip="Ouvrir la caisse (F1)"/>
                        <Button Content="Gestion       F2" Background="#3B82F6" Style="{StaticResource AccueilButton}" Command="{Binding GestionCommand}" ToolTip="Ouvrir la gestion (F2)"/>
                        <Button Content="Outils        F3" Background="#F59E0B" Style="{StaticResource AccueilButton}" Command="{Binding OutilsCommand}" ToolTip="Ouvrir les outils (F3)"/>
                        <Button Content="Info Licence  F4" Background="#06B6D4" Style="{StaticResource AccueilButton}" Command="{Binding InfoLicenceCommand}" ToolTip="Afficher les informations de licence (F4)"/>
                        <Button Content="Quitter       F5" Background="#1E40AF" Style="{StaticResource AccueilButton}" Command="{Binding QuitterCommand}" ToolTip="Quitter POSTEC (F5)"/>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" Text="© 2026 PosTec - Tous droits réservés" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
