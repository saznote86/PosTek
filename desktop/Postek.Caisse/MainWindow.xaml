<Window x:Class="Postec.Caisse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="POSTEC - Caisse" Width="1400" Height="800" MinWidth="1100" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="#F0F4F8" FontFamily="Segoe UI" PreviewKeyDown="SurFenetrePreviewKeyDown">
 <Window.Resources>
  <Style x:Key="HeaderButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="4,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#334155"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="16"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ToucheArticle" TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-3"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#F0F4F8" CornerRadius="10"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#1E293B" CornerRadius="10,10,0,0" Padding="24,0"><Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TexteEntreprise" Text="POSTEC" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,22,0"/><TextBlock Text="| CAISSE" Foreground="#94A3B8" FontSize="18" VerticalAlignment="Center"/><Border Background="#10B981" CornerRadius="16" Padding="12,6" Margin="22,0,0,0"><TextBlock x:Name="TexteStatutCaisse" Text="● CAISSE OUVERTE" Foreground="White" FontWeight="Bold" FontSize="13"/></Border></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="TexteCaissier" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/><Separator Width="1" Background="#475569" Margin="16,8"/><Button x:Name="BoutonBackOffice" Content="Back-Office" Click="SurBackOffice" Style="{StaticResource HeaderButton}" ToolTip="Ouvrir le Back-Office"/><Button x:Name="BoutonMigration" Content="Migration" Click="SurMigration" Style="{StaticResource HeaderButton}" ToolTip="Ouvrir la migration"/><Button x:Name="BoutonClotureZ" Content="Clôture Z" Click="SurClotureZ" Style="{StaticResource HeaderButton}" ToolTip="Clôturer la caisse (F8)"/><Button Content="Fx Encaisser" Click="SurEncaisser" Style="{StaticResource HeaderButton}" ToolTip="Encaisser le ticket (F9)"/><Button Content="Quitter" Click="SurQuitter" Style="{StaticResource HeaderButton}" ToolTip="Fermer la caisse"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,16,0"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="Articles" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/><Button Content="☰" HorizontalAlignment="Right" Width="40" Height="36" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="#64748B" ToolTip="Menu articles"/></Grid>
    <Grid Grid.Row="1" Margin="0,16,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="ChampCodeBarres" Text="{Binding RechercheText,UpdateSourceTrigger=PropertyChanged}" TextChanged="SurRechercheTexteChangee" KeyDown="SurCodeBarresKeyDown" Height="46" Padding="14" FontSize="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="2" ToolTip="Rechercher par code-barres ou nom"/><Button Grid.Column="1" Content="Rechercher" Click="SurRechercherArticle" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="8,0,0,0" FontWeight="Bold" ToolTip="Lancer la recherche"/></Grid>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="PanneauFamilles" Orientation="Horizontal"/></ScrollViewer>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="-8,8,-8,0"><UniformGrid x:Name="GrilleArticles" Columns="6"/></ScrollViewer>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Article sélectionné :" Foreground="#64748B"/><TextBlock x:Name="TexteArticleSelectionne" Foreground="#1E293B" FontWeight="SemiBold" Margin="8,0,0,0"/><TextBlock Text="  Quantité" Foreground="#64748B" Margin="20,0,0,0"/><TextBlock x:Name="TexteSaisieQte" Text="1" Foreground="#1E293B" FontWeight="Bold" Margin="8,0,0,0"/></StackPanel>
   </Grid></Border>
   <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Padding="24"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock x:Name="TitreTicket" Text="Ticket n°1" Foreground="#10B981" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="TexteHeureHaut" HorizontalAlignment="Right" Foreground="#94A3B8" VerticalAlignment="Center"/></Grid>
    <ListBox x:Name="ListeLignes" Grid.Row="1" ItemsSource="{Binding Lignes}" SelectionChanged="SurSelectionLigne" Background="Transparent" BorderThickness="0" Foreground="White" Margin="0,16,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="50"/><ColumnDefinition Width="80"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Article.Designation}" Foreground="White" TextWrapping="Wrap" FontSize="13"/><TextBlock Text="{Binding Article.PrixTtc,StringFormat={}{0:0.000} TND}" Foreground="#94A3B8" FontSize="11"/></StackPanel><TextBox Grid.Column="2" Text="{Binding Quantite,UpdateSourceTrigger=LostFocus}" Tag="{Binding}" LostFocus="SurQuantiteLostFocus" GotFocus="SurQuantiteFocus" Background="#1E293B" Foreground="White" BorderThickness="0" TextAlignment="Center" Padding="3"/><TextBlock Grid.Column="3" Text="{Binding TotalLigne,StringFormat={}{0:0.000}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Grid.Column="4" Content="✕" Tag="{Binding}" Click="SurSupprimerLigne" Background="#F97316" Foreground="White" BorderThickness="0" Width="26" Height="26" ToolTip="Supprimer la ligne"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="RÉSUMÉ FINANCIER" Foreground="#94A3B8" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/><TextBlock x:Name="TexteSousTotal" Foreground="#10B981" FontSize="13"/><TextBlock x:Name="TexteTvaDetail" Foreground="#10B981" FontSize="13"/><TextBlock x:Name="TexteTimbre" Foreground="#10B981" FontSize="13"/><Separator Background="#334155" Margin="0,10"/><TextBlock x:Name="TexteTotal" Foreground="#10B981" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
    <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Payer" Height="52" Background="#10B981" Click="SurEncaisser" Style="{StaticResource ActionButton}" ToolTip="Payer le ticket (F9)"/><Button Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Content="Annuler" Height="52" Background="#EF4444" Click="SurVider" Style="{StaticResource ActionButton}" Margin="10,4,0,4" ToolTip="Annuler le ticket"/><Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Mise en attente" Height="44" Background="#F97316" Click="SurMiseEnAttente" Style="{StaticResource ActionButton}" ToolTip="Mettre le ticket en attente"/><Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Recherche Client" Height="44" Background="#3B82F6" Click="SurRechercheClient" Style="{StaticResource ActionButton}" Margin="10,4,0,4" ToolTip="Rechercher un client"/></Grid>
    <Border Grid.Row="4" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="TexteEtatZ" Text="Z courant : n1 - aucun ticket" Foreground="#94A3B8" FontSize="12"/></Border>
   </Grid></Border>
  </Grid>
  <StackPanel Visibility="Collapsed"><TextBox x:Name="ChampClient" TextChanged="SurClientModifie"/><Button Tag="1" Click="SurToucheQte"/><Button Tag="C" Click="SurToucheQte"/><Button Tag="OK" Click="SurToucheQte"/><Button Tag="QTE1" Click="SurActionRapide"/></StackPanel>
 </Grid></Border>
</Window>