<Window x:Class="Postek.Caisse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POSTEK — Caisse"
        Width="1280" Height="800"
        WindowState="Maximized"
        Background="{DynamicResource CouleurFond}"
        FontFamily="{DynamicResource FamillePolice}">

    <Window.Resources>
        <Style x:Key="ToucheArticle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CouleurToucheFond}"/>
            <Setter Property="Foreground" Value="{DynamicResource CouleurToucheTexte}"/>
            <Setter Property="FontSize" Value="{DynamicResource TaillePoliceClavier}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bordure" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bordure" Property="Background"
                                        Value="{DynamicResource CouleurToucheFondActif}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bordure" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Clavier virtuel des articles -->
        <DockPanel Grid.Column="0" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="POSTEK — Caisse"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource CouleurTexte}" Margin="4,4,4,12"/>
            <Button DockPanel.Dock="Bottom" x:Name="BoutonClotureZ" Content="Clôture Z"
                    Style="{StaticResource ToucheArticle}" Height="56" Margin="0,8,0,0"
                    HorizontalAlignment="Left" Width="170"
                    Click="SurClotureZ"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="TexteEtatZ"
                       Text="Z courant : n° 1 — aucun ticket"
                       FontSize="14"
                       Foreground="{DynamicResource CouleurTexteSecondaire}"
                       Margin="4,8,0,0"/>
            <WrapPanel x:Name="PanneauArticles"/>
        </DockPanel>

        <!-- Ticket en cours -->
        <Border Grid.Column="1" Background="{DynamicResource CouleurSurface}"
                CornerRadius="14" Margin="8" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="TitreTicket" Text="Ticket n° 1"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource CouleurTexte}" Margin="0,0,0,10"/>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Left" x:Name="BoutonVider" Content="Vider"
                            Style="{StaticResource ToucheArticle}" Width="110" Height="56"
                            Click="SurVider"/>
                    <Button x:Name="BoutonEncaisser" Content="Encaisser"
                            Style="{StaticResource ToucheArticle}" Height="56"
                            Background="{DynamicResource CouleurPrimaire}"
                            Click="SurEncaisser"/>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Background="#00000000" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TexteTotal" Text="Total : 0,000 TND"
                                   FontSize="34" FontWeight="Bold"
                                   Foreground="{DynamicResource CouleurTexte}"/>
                        <TextBlock x:Name="TexteTva" Text="dont TVA : 0,000 TND — HT : 0,000 TND"
                                   FontSize="15"
                                   Foreground="{DynamicResource CouleurTexteSecondaire}"/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="ListeLignes" Background="Transparent"
                         Foreground="{DynamicResource CouleurTexte}"
                         FontSize="16" BorderThickness="0"
                         ItemsSource="{Binding Lignes}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0">
                                    <Run Text="{Binding Quantite, Mode=OneWay}"/>
                                    <Run Text="×"/>
                                    <Run Text="{Binding Article.Designation, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalLigne, Mode=OneWay, StringFormat={}{0:0.000} TND}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
